# --- Server ---
PORT=3000
NODE_ENV=production
PUBLIC_URL=https://nena.example.ir
JWT_SECRET=change-me-to-a-long-random-string
DB_PATH=data/nena.db
UPLOAD_DIR=data/uploads
# Comma-separated admin mobiles (get admin access on login)
ADMIN_PHONES=09120000000

# --- SMS (OTP): mock | kavenegar ---
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=nena-otp

# --- Payment gateway: mock | zarinpal ---
PAYMENT_PROVIDER=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=0

# --- Maps ---
# Routing: estimate | osrm | neshan ; Geocoder: nominatim | neshan | none
ROUTING_PROVIDER=neshan
GEOCODER=neshan
NESHAN_API_KEY=
OSRM_URL=https://router.project-osrm.org
TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=&copy; OpenStreetMap
